{
  "name": "dos-browser",
  "version": "0.1.0",
  "description": "A retro-styled suite of web browsing tools built in Node.js: heuristic semantic DOM extraction with TUI, CLI, and an MCP server so AI agents can read the web as clean Markdown.",
  "keywords": [
    "browser",
    "cli",
    "tui",
    "mcp",
    "model-context-protocol",
    "web-scraping",
    "dom",
    "readability",
    "markdown",
    "ai-agents",
    "website-to-json"
  ],
  "homepage": "https://github.com/EthicalSaving-gUG/WebsiteToJSON#readme",
  "bugs": {
    "url": "https://github.com/EthicalSaving-gUG/WebsiteToJSON/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthicalSaving-gUG/WebsiteToJSON.git"
  },
  "license": "MIT",
  "author": "Ethicalsaving gUG",
  "bin": {
    "dos-browser": "browser-cli.js",
    "dos-browser-tui": "tui-browser.js",
    "dos-browser-mcp": "mcp-server.js"
  },
  "files": [
    "browser-cli.js",
    "tui-browser.js",
    "mcp-server.js",
    "config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --check mcp-server.js && node --check browser-cli.js && node --check tui-browser.js",
    "clean": "taskkill /F /IM node.exe /T"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.5.0",
    "autoprefixer": "^10.4.27",
    "blessed": "^0.1.81",
    "dompurify": "^3.1.5",
    "jimp": "^0.22.12",
    "jsdom": "^24.1.0",
    "next": "16.1.6",
    "open": "^11.0.0",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.2.1"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
