{
  "name": "websitetojson",
  "version": "0.1.0",
  "private": true,
  "description": "DOS Browser — a retro-styled suite that extracts the semantic content of websites as clean JSON/Markdown, with CLI, TUI, VS Code, and MCP server interfaces.",
  "keywords": [
    "mcp",
    "web-scraping",
    "readability",
    "dom-extraction",
    "cli",
    "tui",
    "markdown",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthicalSaving-gUG/WebsiteToJSON.git"
  },
  "bin": {
    "dos-browser": "tui-browser.js",
    "dos-browser-cli": "browser-cli.js",
    "dos-browser-mcp": "mcp-server.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.5.0",
    "autoprefixer": "^10.4.27",
    "blessed": "^0.1.81",
    "dompurify": "^3.1.5",
    "jimp": "^0.22.12",
    "jsdom": "^24.1.0",
    "next": "16.1.6",
    "open": "^11.0.0",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
