{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.json",
  "name": "io.github.ethicalsaving-gug/dos-browser",
  "description": "Semantic web-to-Markdown browsing for AI agents, with a built-in ad blocker, cookie-wall bypass, and prompt-injection firewall.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/EthicalSaving-gUG/WebsiteToJSON",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "dos-browser",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "dos-browser-mcp",
          "valueHint": "binary"
        }
      ]
    }
  ]
}
